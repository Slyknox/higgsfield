# Server-only settings. Copy to .env.local for development; set them as
# environment variables in Vercel. Never commit real values.

HF_API_BASE_URL=https://api.higgsfield.ai

# Supabase Postgres: Project settings → Database → Connection string (URI).
# Use the pooler URL with ?sslmode=require in production.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/studio_dev

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# resend (real email) or outbox (local only: links go to the email_outbox
# table and the server log). outbox is refused unless AUTH_URL is localhost.
EMAIL_TRANSPORT=outbox
AUTH_RESEND_KEY=
EMAIL_FROM="design.ai <login@example.com>"

# ── Generation (Phase 3) ─────────────────────────────────────────────────────
# The complete key copied from open.higgsfield.ai/api-keys, pasted as-is.
HF_API_KEY=
# Public HTTPS base Higgsfield can call back (e.g. https://your-domain.com).
# Leave unset locally: the status route and cron then poll instead.
HF_WEBHOOK_BASE_URL=
# 32+ random characters; signs the webhook URL. Required with HF_WEBHOOK_BASE_URL.
HF_WEBHOOK_SECRET=
# Generations one user can run at once.
MAX_CONCURRENT_GENERATIONS=4
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (16+ characters).
CRON_SECRET=

# local (localhost only, files in LOCAL_MEDIA_DIR) or r2.
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=.data/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=
