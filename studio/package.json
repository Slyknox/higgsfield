{
  "name": "higgsfield-app-templates",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "models": "node scripts/sync-models.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/pg-adapter": "1.11.3",
    "@base-ui/react": "^1.8.0",
    "@react-email/components": "1.0.12",
    "@tanstack/react-virtual": "^3.14.13",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
